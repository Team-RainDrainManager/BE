# 로컬 개발용 비밀값 예시. 레포 루트에 .env로 복사해서 값을 채운다 (.env는 커밋 금지)
#   cp .env.local.example .env
# 형식: KEY=VALUE (따옴표 없이). local 프로필이 spring.config.import로 읽는다

# JWT 서명 키 (Base64, 디코딩 후 32바이트 이상). 생성: openssl rand -base64 32
JWT_SECRET=<openssl rand -base64 32 결과>

# 허용할 프론트엔드 origin (쉼표로 구분)
CORS_ALLOWED_ORIGINS=http://localhost:5173

# 카카오 REST API 키 (카카오 디벨로퍼스 > 내 애플리케이션 > 앱 키 > REST API 키)
KAKAO_CLIENT_ID=<REST API 키>
# 카카오 Client Secret (카카오 로그인 > 보안 > Client Secret 코드, 활성화 상태 '사용함')
KAKAO_CLIENT_SECRET=<Client Secret>
# 허용할 카카오 redirectUri (쉼표로 구분). 카카오 디벨로퍼스 > 카카오 로그인 > Redirect URI 에 똑같이 등록
KAKAO_ALLOWED_REDIRECT_URIS=http://localhost:5173/oauth/kakao,http://localhost:8080/api/v1/auth/kakao/callback
