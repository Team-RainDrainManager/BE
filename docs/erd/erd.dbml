// 빗물받이 집사 ERD v6.3 (최종 확정)
// DB: PostgreSQL. 위도·경도 double precision(Java Double), 시각 timestamp(한국 시간, Java LocalDateTime)
// 모든 테이블 created_at / updated_at / deleted_at = BaseEntity 공통 (deleted_at null = 살아 있는 행)
// ❓ = 팀 확정 필요

Project rain_butler {
  database_type: 'PostgreSQL'
}

// ───────── 사용자 ─────────

Table users {
  id bigint [pk, increment]
  provider varchar [not null, note: 'KAKAO / LOCAL']
  provider_id varchar [note: '카카오 회원번호 (자체 로그인은 null)']
  nickname varchar [not null]
  real_name varchar [note: '실명 (봉사 확인서용)']
  identity_verified_at timestamp [note: '실명 인증 시각']
  email varchar
  profile_image varchar
  password varchar(255) [note: 'BCrypt 해시 (자체 로그인만)']
  role varchar [not null, note: 'ADMIN / CITY_OFFICIAL / USER']
  point int [not null, default: 0, note: 'point_history 합계']
  level int [not null, default: 1, note: '사용자 전체 활동 레벨']
  latitude "double precision" [note: '활동 위치 - 대신 점검 대상 판정']
  longitude "double precision"
  location_updated_at timestamp [note: '활동 위치 갱신 시각']
  onboarding_completed_at timestamp [note: '온보딩(약관 동의 + 본인인증) 완료 시각. null이면 미완료']
  notification_enabled boolean [not null, default: false, note: '활동 알림 수신 동의']
  night_push_consent boolean [not null, default: false, note: '야간(22시~08시) 푸시 수신 동의']
  pause_until timestamp [note: '점검 쉬기 종료 시각. 이 시각 전이면 쉬는 중']
  last_pause_requested_at timestamp [note: '마지막 쉬기 신청 시각 (90일 쿨다운 판정)']
  created_at timestamp [not null]
  updated_at timestamp [not null]
  deleted_at timestamp

  indexes {
    (provider, provider_id) [unique]
  }

  Note: '자체 로그인 이메일 유니크 (UNIQUE lower(email) WHERE provider=LOCAL) / LOCAL은 email·password, KAKAO는 provider_id 필수 (CHECK, 탈퇴한 계정은 제외)'
}

Table refresh_token {
  id bigint [pk, increment]
  user_id bigint [not null, ref: > users.id]
  token_hash varchar(64) [unique, not null, note: 'refresh 토큰 SHA-256 (원문은 저장하지 않음)']
  expires_at timestamp [not null]
  revoked_at timestamp [note: '폐기 시각 (회전 · 로그아웃 · 탈취 감지)']
  created_at timestamp [not null]
  updated_at timestamp [not null]
  deleted_at timestamp

  indexes {
    user_id
  }

  Note: '재발급마다 회전. 폐기된 토큰이 다시 오면 해당 사용자 토큰 전부 폐기 (탈취 감지)'
}

Table terms {
  id bigint [pk, increment]
  type varchar [not null, note: 'AGE_14 / SERVICE / PRIVACY / LOCATION / SAFETY / NOTIFICATION / NIGHT_PUSH']
  version int [not null, note: '약관 버전 (type별 1부터)']
  title varchar [not null, note: '체크박스 문구 ([필수]/[선택] 접두어 제외)']
  required boolean [not null, note: '필수 동의 여부']
  content_path varchar [note: '약관 전문 markdown의 classpath 경로 (전문 없으면 null)']
  display_order int [not null, note: '화면 표시 순서']
  effective_at timestamp [not null, note: '시행 시각']
  created_at timestamp [not null]
  updated_at timestamp [not null]
  deleted_at timestamp

  indexes {
    (type, version) [unique, name: 'uq_terms_type_version']
  }

  Note: '약관 마스터. 개정하면 같은 type에 version을 올린 새 행을 추가한다'
}

Table user_terms_agreement {
  id bigint [pk, increment]
  user_id bigint [not null, ref: > users.id]
  terms_id bigint [not null, ref: > terms.id]
  agreed boolean [not null, note: '동의 여부 (선택 약관 미동의도 false로 남긴다)']
  agreed_at timestamp [not null, note: '동의(또는 철회) 시각']
  created_at timestamp [not null]
  updated_at timestamp [not null]
  deleted_at timestamp

  indexes {
    (user_id, terms_id, agreed_at) [name: 'idx_user_terms_agreement_user']
  }

  Note: '동의·철회 이력. 수정하지 않고 새 행 추가'
}

Table sanction {
  id bigint [pk, increment]
  user_id bigint [not null, ref: > users.id]
  report_id bigint [ref: > report.id, note: '원인 제보 (없을 수 있음)']
  imposed_by bigint [ref: > users.id, note: '부과한 관리자·시청 사용자']
  reason varchar [not null, note: '제재 사유 (사용자에게 보임)']
  starts_at timestamp [not null, note: '시작 시각. 제재 중에 추가로 부과되면 기존 종료 시각부터 시작']
  until timestamp [note: '종료 시각. 영구면 null']
  permanent boolean [not null, default: false, note: '영구 제재 여부']
  revoked_at timestamp [note: '관리자 해제 시각. 해제된 제재는 누적 횟수에서 제외']
  created_at timestamp [not null]
  updated_at timestamp [not null]
  deleted_at timestamp

  indexes {
    (user_id, starts_at) [name: 'idx_sanction_user']
  }

  Note: '사용자 제재. 허위 제보 1회 7일 · 2회 14일 · 3회 이상 영구'
}

Table fcm_token {
  id bigint [pk, increment]
  user_id bigint [not null, ref: > users.id]
  token text [unique, not null, note: 'FCM 등록 토큰']
  platform varchar [not null, note: 'WEB / ANDROID / IOS']
  last_used_at timestamp [not null, note: '마지막 등록·갱신 시각']
  created_at timestamp [not null]
  updated_at timestamp [not null]
  deleted_at timestamp

  indexes {
    user_id
  }

  Note: 'FCM 기기 토큰. 사용자당 여러 기기 가능. 무효 토큰은 하드 삭제'
}

Table photo_hash {
  id bigint [pk, increment]
  hash varchar(64) [unique, not null, note: 'SHA-256 - 같은 사진 재사용 차단']
  source_table varchar [not null, note: 'cleaning / management_log / ai_verification / report / drain']
  source_id bigint [not null]
  photo_role varchar [not null, note: 'BEFORE / AFTER / REPORT / DRAIN']
  created_at timestamp [not null]
  updated_at timestamp [not null]
  deleted_at timestamp
}

Table point_history {
  id bigint [pk, increment]
  user_id bigint [not null, ref: > users.id]
  source_type varchar [not null, note: 'CLEANING / MANAGEMENT / REPORT']
  source_id bigint [not null]
  amount int [not null]
  type varchar [not null, note: 'EARN / REVOKE']
  description varchar
  created_at timestamp [not null]
  updated_at timestamp [not null]
  deleted_at timestamp
}

// ───────── 배수구 · 입양 ─────────

Table drain {
  id bigint [pk, increment]
  registered_by bigint [ref: > users.id, note: '등록자 (현장 조사한 관리자 or 제보자)']
  latitude "double precision" [not null]
  longitude "double precision" [not null]
  photo_url varchar [not null, note: '최신 현장 사진 (청소·관리 때마다 갱신)']
  dirt_level int [not null, note: '최신 더러움 단계 1 / 2 / 3']
  adoption_status varchar [not null, note: 'AVAILABLE / ADOPTED']
  status varchar [not null, note: 'ACTIVE / PENDING(신규 제보 승인 대기) / REMOVED']
  is_risk boolean [not null, default: false, note: '위험 배수구 - 현장 조사 때 등록하면서 지정']
  created_at timestamp [not null]
  updated_at timestamp [not null]
  deleted_at timestamp
}

Table adoption {
  id bigint [pk, increment]
  user_id bigint [not null, ref: > users.id]
  drain_id bigint [not null, ref: > drain.id]
  cleaning_id bigint [unique, not null, ref: - cleaning.id, note: '입양 조건 청소 (청소 1건 = 입양 1건)']
  nickname varchar [not null, note: '배수구에 붙인 이름']
  status varchar [not null, note: 'ACTIVE / RELEASED']
  release_reason varchar [note: 'MOVED / NO_TIME / OTHER / AUTO(35일 미관리) / WITHDRAWN(회원 탈퇴)']
  level int [not null, default: 1, note: '배수구 캐릭터 레벨 - 입양자 바뀌면 초기화']
  score int [not null, default: 0]
  ignore_count int [not null, default: 0, note: '비 예보 요청 연속 무응답']
  adopted_at timestamp [not null]
  last_managed_at timestamp [note: '마지막 점검일 - 35일 미점검 자동 파양 판정']
  next_management_at timestamp [note: '다음 관리 예정일 (14일)']
  released_at timestamp
  created_at timestamp [not null]
  updated_at timestamp [not null]
  deleted_at timestamp

  Note: '사용자당 ACTIVE 최대 3개 (서비스 로직) / 배수구당 ACTIVE 1개 (UNIQUE drain_id WHERE status=ACTIVE)'
}

Table management_log {
  id bigint [pk, increment]
  adoption_id bigint [not null, ref: > adoption.id]
  request_id bigint [unique, ref: - inspection_request.id, note: '비 예보 요청으로 한 관리면 연결']
  type varchar [not null, note: 'REGULAR(정기 점검) / RAIN(비 예보 점검 - request_id 있음)']
  action_type varchar [not null, note: 'INSPECTION(살펴보기만) / CLEANING(청소까지)']
  status varchar [not null, note: 'SUBMITTED / VERIFIED / FAILED']
  review_status varchar [not null, note: 'NOT_REQUIRED / PENDING / APPROVED / REJECTED']
  reviewed_by bigint [ref: > users.id]
  reviewed_at timestamp
  before_photo_url varchar
  after_photo_url varchar
  dirt_level int [note: 'AI 더러움 단계 1~3']
  ai_confidence "numeric(3,2)"
  memo varchar
  latitude "double precision" [note: '촬영 위치']
  longitude "double precision"
  location_mismatch boolean [not null, default: false, note: '50m 이상']
  managed_at timestamp
  created_at timestamp [not null]
  updated_at timestamp [not null]
  deleted_at timestamp
}

// ───────── 청소 · AI ─────────

Table cleaning {
  id bigint [pk, increment]
  user_id bigint [not null, ref: > users.id]
  drain_id bigint [not null, ref: > drain.id]
  request_id bigint [unique, ref: - inspection_request.id, note: '대신 점검이면 연결']
  type varchar [not null, note: 'ADOPTION(입양 전 청소) / SUBSTITUTE(대신 점검)']
  before_photo_url varchar [not null]
  dirt_level int [note: 'AI가 비포 사진으로 판정한 더러움 1~3']
  dirt_confidence "numeric(3,2)"
  status varchar [not null, note: '진행 상태: IN_PROGRESS / VERIFYING / COMPLETED / FAILED']
  review_status varchar [not null, note: 'NOT_REQUIRED / PENDING / APPROVED / REJECTED']
  reviewed_by bigint [ref: > users.id]
  reviewed_at timestamp
  latitude "double precision" [not null]
  longitude "double precision" [not null]
  location_mismatch boolean [not null, default: false]
  started_at timestamp [not null]
  completed_at timestamp
  created_at timestamp [not null]
  updated_at timestamp [not null]
  deleted_at timestamp
}

Table ai_verification {
  id bigint [pk, increment]
  cleaning_id bigint [ref: > cleaning.id, note: 'cleaning_id / management_log_id 중 하나만']
  management_log_id bigint [ref: > management_log.id]
  attempt_no int [not null]
  after_photo_url varchar [not null]
  result varchar [not null, note: 'PASS / FAIL']
  confidence "numeric(3,2)"
  reason varchar
  verified_at timestamp [not null]
  created_at timestamp [not null]
  updated_at timestamp [not null]
  deleted_at timestamp
}

// ───────── 도구함 ─────────

Table tool_box {
  id bigint [pk, increment]
  name varchar [not null]
  latitude "double precision" [not null]
  longitude "double precision" [not null]
  total_count int [not null, note: '구비된 세트 수']
  available_count int [not null, note: '대여 시 -1, 반납 시 +1']
  status varchar [not null, note: 'AVAILABLE / ALL_RENTED (available_count = 0)']
  created_at timestamp [not null]
  updated_at timestamp [not null]
  deleted_at timestamp
}

Table tool_rental {
  id bigint [pk, increment]
  user_id bigint [not null, ref: > users.id]
  tool_box_id bigint [not null, ref: > tool_box.id]
  status varchar [not null, note: 'RENTED / RETURNED']
  rented_at timestamp [not null]
  returned_at timestamp
  created_at timestamp [not null]
  updated_at timestamp [not null]
  deleted_at timestamp

  Note: '빌릴 때 tool_box.available_count -1, 반납할 때 +1 / 1인 1개만 대여 (UNIQUE user_id WHERE status=RENTED) / 빌린 도구함에만 반납'
}

// ───────── 비 예보 → 점검 요청 ─────────

Table rain_forecast {
  id bigint [pk, increment]
  rain_date date [not null, note: '비 오는 날']
  rain_start_at timestamp [not null]
  pop int [not null, note: '강수확률 %']
  pcp_mm "numeric(5,2)" [not null, note: '1시간 강수량']
  status varchar [not null, note: 'ACTIVE / CANCELLED']
  is_simulated boolean [not null, default: false, note: '시연용 가상 예보']
  created_at timestamp [not null]
  updated_at timestamp [not null]
  deleted_at timestamp
}

Table inspection_request {
  id bigint [pk, increment]
  forecast_id bigint [not null, ref: > rain_forecast.id]
  drain_id bigint [not null, ref: > drain.id]
  adoption_id bigint [ref: > adoption.id, note: '입양자에게 간 요청. 미입양 위험 배수구면 null → 바로 대신 점검 공개']
  substitute_user_id bigint [ref: > users.id, note: '대신 점검 수락자 (선착순 1명)']
  status varchar [not null, note: 'SENT / ACCEPTED / OPEN / CLAIMED / COMPLETED / MISSED / CANCELLED']
  reply varchar [note: 'ACCEPT / DECLINE / null(무응답)']
  sent_at timestamp [not null, note: '전날 06:00 일괄 발송']
  reply_deadline_at timestamp [not null, note: '전날 20:00 - 지나면 대신 점검으로 공개 (점검 마감은 로직에서 처리)']
  replied_at timestamp
  opened_at timestamp
  claimed_at timestamp
  completed_at timestamp
  created_at timestamp [not null]
  updated_at timestamp [not null]
  deleted_at timestamp

  indexes {
    (forecast_id, drain_id) [unique]
  }
}

// ───────── 제보 · 알림 ─────────

Table report {
  id bigint [pk, increment]
  user_id bigint [not null, ref: > users.id]
  drain_id bigint [not null, ref: > drain.id]
  processed_by bigint [ref: > users.id, note: '처리한 시청 관계자·관리자']
  type varchar [not null, note: 'BLOCKAGE / NEW_DRAIN / LOCATION_FIX / REMOVAL']
  description varchar
  photo_url varchar
  new_latitude "double precision" [note: 'LOCATION_FIX 제보의 새 위치']
  new_longitude "double precision"
  status varchar [not null, note: 'PENDING / APPROVED / REJECTED']
  admin_comment varchar
  resolved_at timestamp
  created_at timestamp [not null]
  updated_at timestamp [not null]
  deleted_at timestamp
}

Table notification {
  id bigint [pk, increment]
  user_id bigint [not null, ref: > users.id]
  request_id bigint [ref: > inspection_request.id]
  adoption_id bigint [ref: > adoption.id]
  type varchar [not null, note: 'RAIN_TOMORROW / SUBSTITUTE_OPEN / MANAGEMENT_DUE / ...']
  title varchar [not null]
  body varchar [not null]
  sent_at timestamp
  read_at timestamp
  created_at timestamp [not null]
  updated_at timestamp [not null]
  deleted_at timestamp
}
