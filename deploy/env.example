# 서버 /opt/rain-butler/.env 예시. 이 파일에는 변수 이름과 자리표시자만 쓴다 (실제 값 커밋 금지)
# 서버에서: cp env.example .env && chmod 600 .env 후 값을 채운다

# 앱 이미지 이름 (ghcr.io/<github 레포 소문자>)
IMAGE_NAME=ghcr.io/team-raindrainmanager/be

# DB 운영 방식: container(서버 DB 컨테이너) / rds(RDS 이전 후 → 배포 때 db 컨테이너를 켜지 않음)
DB_MODE=container

# ───────── 서버 DB 컨테이너 (RDS 이전 전까지) ─────────
# 서버 DB 이름
POSTGRES_DB=rainbutler
# 서버 DB 사용자
POSTGRES_USER=rainbutler
# 서버 DB 비밀번호 (직접 생성, 예: openssl rand -base64 24)
POSTGRES_PASSWORD=<직접 생성>

# ───────── 앱 DB 접속 ─────────
# 앱이 접속할 DB 주소. 서버 DB 컨테이너면 아래 값 그대로, RDS 이전 후에는 RDS 엔드포인트로 변경
DB_URL=jdbc:postgresql://db:5432/rainbutler
# 앱 DB 사용자 (서버 DB면 POSTGRES_USER와 같은 값)
DB_USERNAME=rainbutler
# 앱 DB 비밀번호 (서버 DB면 POSTGRES_PASSWORD와 같은 값)
DB_PASSWORD=<POSTGRES_PASSWORD와 같은 값>

# ───────── 기타 ─────────
# 운영 Swagger UI 노출 여부
SWAGGER_ENABLED=false

# ───────── 이후 추가 예정 (각 기능 작업 때) ─────────
# KAKAO_*          카카오 로그인
# JWT_SECRET       JWT 서명 키
# GEMINI_API_KEY   AI 사진 판정
# KMA_API_KEY      기상청 API
# AWS_S3_BUCKET    사진 저장소
# VAPID_*          웹 푸시
