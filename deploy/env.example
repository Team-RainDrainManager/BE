# 서버 /opt/rain-butler/.env 예시. 이 파일에는 변수 이름과 자리표시자만 쓴다 (실제 값 커밋 금지)
# 서버에서: cp env.example .env && chmod 600 .env 후 값을 채운다

# 앱 이미지 이름 (ghcr.io/<github 레포 소문자>)
IMAGE_NAME=ghcr.io/team-raindrainmanager/be

# DB 운영 방식: container(서버 DB 컨테이너) / rds(RDS 이전 후 → 배포 때 db 컨테이너를 켜지 않음)
DB_MODE=container

# ───────── 서버 DB 컨테이너 (RDS 이전 전까지) ─────────
# 서버 DB 이름
POSTGRES_DB=rainbutler
# 서버 DB 사용자
POSTGRES_USER=rainbutler
# 서버 DB 비밀번호 (직접 생성, 예: openssl rand -base64 24)
POSTGRES_PASSWORD=<직접 생성>

# ───────── 앱 DB 접속 ─────────
# 앱이 접속할 DB 주소. 서버 DB 컨테이너면 아래 값 그대로, RDS 이전 후에는 RDS 엔드포인트로 변경
DB_URL=jdbc:postgresql://db:5432/rainbutler
# 앱 DB 사용자 (서버 DB면 POSTGRES_USER와 같은 값)
DB_USERNAME=rainbutler
# 앱 DB 비밀번호 (서버 DB면 POSTGRES_PASSWORD와 같은 값)
DB_PASSWORD=<POSTGRES_PASSWORD와 같은 값>

# ───────── 인증 ─────────
# JWT 서명 키 (Base64, 디코딩 후 32바이트 이상). 서버에서 새로 생성: openssl rand -base64 32
#   없거나 짧으면 앱이 시작되지 않는다. 로컬 값과 다르게 만든다
JWT_SECRET=<openssl rand -base64 32 결과>
# 허용할 프론트엔드 origin (쉼표로 구분, 운영 프론트 도메인)
CORS_ALLOWED_ORIGINS=https://<운영 프론트 도메인>
# 카카오 REST API 키 (카카오 디벨로퍼스 > 앱 키)
KAKAO_CLIENT_ID=<REST API 키>
# 카카오 Client Secret
KAKAO_CLIENT_SECRET=<Client Secret>
# 허용할 카카오 redirectUri (운영 프론트 주소. 카카오 디벨로퍼스에도 똑같이 등록)
KAKAO_ALLOWED_REDIRECT_URIS=https://<운영 프론트 도메인>/oauth/kakao

# ───────── 사진 저장소 (S3) ─────────
# 운영은 EC2 IAM Role로 인증. 키 넣지 말 것 (S3_ACCESS_KEY · S3_SECRET_KEY 없음)
# 버킷 이름 (비공개 버킷)
S3_BUCKET=<버킷 이름>
# 리전
S3_REGION=ap-northeast-2
# key 접두어 (운영은 prod)
S3_KEY_PREFIX=prod

# ───────── 푸시 (FCM) ─────────
# Firebase 서비스 계정 JSON을 Base64 한 줄로. 생성: base64 -i key.json | tr -d '\n'
#   비워 두면 푸시를 보내지 않는다 (알림 저장은 됨)
FIREBASE_CREDENTIALS_BASE64=<서비스 계정 JSON의 base64>

# ───────── 기타 ─────────
# 운영 Swagger UI 노출 여부
SWAGGER_ENABLED=false

# ───────── 이후 추가 예정 (각 기능 작업 때) ─────────
# GEMINI_API_KEY   AI 사진 판정
# KMA_API_KEY      기상청 API
